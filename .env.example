# Copy to .env.local (git-ignored) only if you need to change a default; the app runs without any env file for local development.

# Where the Laravel API (service-on-click-api) listens, as an origin: http://host:port, with no /api (the app adds it; a trailing /api
# is dropped). Next.js forwards every /api/* request to it (see next.config.mjs), so the browser sees a single origin: no CORS,
# and the HttpOnly session cookie the API sets at login just works.
# NOTE: Next evaluates rewrites when `next dev` starts and when `next build` runs - for production set it BEFORE `npm run build`.
API_ORIGIN=http://localhost:8000

# Show the "log in with a personal number" form on /login. The local API accepts a bare personal number (no secret);
# production signs in through ADFS, so set this to false there. Inlined at build time.
NEXT_PUBLIC_DEV_LOGIN=true

# Optional: where to send a user whose session ended when the personal-number form is off (e.g. the ADFS sign-in address).
# Leave empty to go to /login. Inlined at build time.
NEXT_PUBLIC_LOGIN_URL=
