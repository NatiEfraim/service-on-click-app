# ---------- Build stage: install deps and build the Next.js app ----------
FROM node:24-alpine AS builder

# All of these are fixed by `next build` (rewrites and NEXT_PUBLIC_* are baked in), so each environment is its own image.
# API_ORIGIN: where service-on-click-api (DEV) is; origin only - the app adds the API's /api prefix itself.
ENV API_ORIGIN=http://denver.idf
# Login: false = ADFS (this image); true = personal-number form, local development only (see .env.example).
ENV NEXT_PUBLIC_DEV_LOGIN=false
# ADFS: the login page loads ${NEXT_PUBLIC_ADFS_URL}/api/token in a hidden frame, takes the token it posts and sends `{ token }` to the API's /login.
ENV NEXT_PUBLIC_ADFS_URL=https://vm0099adfs.army.secret
ENV NEXT_PUBLIC_LOGIN_URL=https://vm0099adfs.army.secret
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Install dependencies first so this layer is cached when only source changes (.npmrc keeps ignore-scripts)
COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .

# Swap in the ADFS-specific files, then build
RUN mv ADFS/axios.js app/lib/ && \
    mv ADFS/useAuth.js app/hooks/ && \
    mv ADFS/page.js app/ && \
    rm -rf ADFS && \
    npm run build

# ---------- Runtime stage: only the standalone server output ----------
FROM node:24-alpine

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /var/www/html

COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node

EXPOSE 3000

CMD ["node", "server.js"]
